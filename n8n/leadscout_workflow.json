{
  "name": "LeadScout: research new leads from Google Sheets",
  "nodes": [
    {
      "id": "8f1d2a01-0000-4000-8000-000000000001",
      "name": "New lead in Inbox sheet",
      "type": "n8n-nodes-base.googleSheetsTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "parameters": {
        "pollTimes": {"item": [{"mode": "everyMinute"}]},
        "documentId": {"__rl": true, "value": "YOUR_GOOGLE_SHEET_ID", "mode": "id"},
        "sheetName": {"__rl": true, "value": "Inbox", "mode": "name"},
        "event": "rowAdded",
        "options": {}
      }
    },
    {
      "id": "8f1d2a01-0000-4000-8000-000000000002",
      "name": "Research, score and draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8100/api/leads/run",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "X-API-Key", "value": "CHANGE_ME_SAME_AS_LEADSCOUT_API_KEY"}]},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ company: $json.company, website: $json.website, segment_hint: $json.segment || null }) }}",
        "options": {"timeout": 180000}
      }
    },
    {
      "id": "8f1d2a01-0000-4000-8000-000000000003",
      "name": "Ready for review?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [520, 0],
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2},
          "conditions": [
            {
              "id": "6c0d7f2e-1111-4a2b-9c3d-000000000001",
              "leftValue": "={{ $json.status }}",
              "rightValue": "ready_for_review",
              "operator": {"type": "string", "operation": "equals"}
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "8f1d2a01-0000-4000-8000-000000000004",
      "name": "Email me for approval",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [780, -100],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "you@example.com",
        "subject": "={{ 'LeadScout: ' + $json.company + ' scored ' + $json.score + '/10, draft ready' }}",
        "emailType": "text",
        "message": "={{ $json.company + ' (' + $json.segment + ') scored ' + $json.score + '/10.\\n\\nDraft subject: ' + $json.draft_subject + '\\n\\nReview, edit and approve: ' + $json.review_url }}",
        "options": {}
      }
    },
    {
      "id": "8f1d2a01-0000-4000-8000-000000000005",
      "name": "Not a fit or needs a look",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [780, 100],
      "parameters": {}
    }
  ],
  "connections": {
    "New lead in Inbox sheet": {"main": [[{"node": "Research, score and draft", "type": "main", "index": 0}]]},
    "Research, score and draft": {"main": [[{"node": "Ready for review?", "type": "main", "index": 0}]]},
    "Ready for review?": {"main": [
      [{"node": "Email me for approval", "type": "main", "index": 0}],
      [{"node": "Not a fit or needs a look", "type": "main", "index": 0}]
    ]}
  },
  "settings": {"executionOrder": "v1"},
  "pinData": {}
}
