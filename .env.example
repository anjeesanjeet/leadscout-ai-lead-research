# ---- LLM provider: anthropic or openai ----
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Leave empty unless your model needs it
LLM_TEMPERATURE=

# Prices in USD per 1M tokens, for cost tracking. Check your provider's current pricing.
ANTHROPIC_PRICE_INPUT_PER_MTOK=1.0
ANTHROPIC_PRICE_OUTPUT_PER_MTOK=5.0
OPENAI_PRICE_INPUT_PER_MTOK=0.40
OPENAI_PRICE_OUTPUT_PER_MTOK=1.60

# ---- News search (optional but recommended) ----
TAVILY_API_KEY=
# USD per search, for cost tracking. Check Tavily's current pricing.
TAVILY_PRICE_PER_SEARCH=0.008

# ---- Research and scoring ----
MAX_PAGES=4
FIT_THRESHOLD=6
GROUNDING_MIN_SCORE=90

# ---- Google Sheets (optional) ----
# Path to the service-account JSON key, and the spreadsheet id from its URL.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_ID=

# ---- HubSpot (optional) ----
# Private app access token with CRM companies and notes scopes.
HUBSPOT_TOKEN=

# ---- Server ----
# Protects /api/leads/run (used by n8n). Put the same value in the n8n HTTP Request node.
LEADSCOUT_API_KEY=
PUBLIC_BASE_URL=http://127.0.0.1:8100
HOST=127.0.0.1
PORT=8100
DB_PATH=data/leadscout.db
